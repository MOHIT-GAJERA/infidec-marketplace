# Public site URL used for canonical links, sitemap, Open Graph and JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.infidec-marketplace.in

# REQUIRED in production: long random string used to sign login sessions
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Payment Gateway mode: "live" enables real payments via Razorpay; unset/other runs demo mode
NEXT_PUBLIC_PAYMENT_MODE=live

# Razorpay credentials
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...
# Optional webhook secret configured in Razorpay Dashboard -> Webhooks
RAZORPAY_WEBHOOK_SECRET=

# Firebase / Firestore (accounts and orders)
# FIREBASE_PROJECT_ID=marketplace-infidec
# Local dev only – path to a service-account JSON; on Firebase the runtime account is used
# FIREBASE_SERVICE_ACCOUNT_FILE=./secret/marketplace-infidec-firebase-private-key.json
