# Public site URL used for canonical links, sitemap, Open Graph and JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.infidec-marketplace.in

# REQUIRED in production: long random string used to sign login sessions
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Where users.json / orders.json are stored (default: ./.data)
# DATA_DIR=/var/lib/infidec-marketplace

# "live" hides the demo-payment notice once a real gateway (Razorpay/Stripe) is connected
# NEXT_PUBLIC_PAYMENT_MODE=live
